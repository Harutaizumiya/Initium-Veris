# Gemini support used by the existing project.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App host used by the existing project.
APP_URL="MY_APP_URL"

# Local frontend logs. Debug mode enables logging by default when this is unset.
VITE_LOG_ENABLED=false
VITE_LOG_LEVEL=info
VITE_LOG_MAX_ENTRIES=200

# Demo mode uses front-end in-memory mock data. No API base URL is required.
