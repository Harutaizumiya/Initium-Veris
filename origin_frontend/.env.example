# Gemini support used by the existing project.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App host used by the existing project.
APP_URL="MY_APP_URL"

# Django API base URL. Keep the /api suffix to match the backend contract.
VITE_API_BASE_URL="http://localhost:8000/api"

# Local frontend logs. Debug mode enables logging by default when this is unset.
VITE_LOG_ENABLED=false
VITE_LOG_LEVEL=info
VITE_LOG_MAX_ENTRIES=200

# Deprecated: authentication is now handled by the login flow and local runtime token storage.
